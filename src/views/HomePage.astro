  <div class="row r2"><div class="track"><i class="cv s-lib" style="--x:196.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:648.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:194.5;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-home" style="--x:196.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:732.5;--y:237.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:949.8;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:799.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:497.8;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:13.5;--y:207.5;--w:75;--h:116"></i><i class="cv s-yir" style="--x:1073.8;--y:216.5;--w:151;--h:202"></i><i class="cv s-home" style="--x:497.8;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:196.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:648.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:194.5;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-home" style="--x:196.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:732.5;--y:237.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:949.8;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:799.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:497.8;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:13.5;--y:207.5;--w:75;--h:116"></i><i class="cv s-yir" style="--x:1073.8;--y:216.5;--w:151;--h:202"></i><i class="cv s-home" style="--x:497.8;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:196.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:648.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:194.5;--y:55.5;--w: