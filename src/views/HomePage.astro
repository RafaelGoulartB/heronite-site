---
import '../styles/home.css';
import '../styles/content.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ShotImg from '../components/ShotImg.astro';
import DownloadCards from '../components/DownloadCards.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Faq from '../components/Faq.astro';
import { backdrop, medium } from '../lib/shots';
import { articles, articleUrl, slugOf } from '../lib/content';
import { latest, totalDownloads, version } from '../lib/releases';
import { downloads, site, stores } from '../data/site';
import { fill, localeInfo, localize, useText, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const text = useText(lang);
const t = text.home;
const to = (path: string) => localize(lang, path);

const bg = Object.fromEntries(
  await Promise.all(
    ['statistics', 'console-library', 'year-in-review', 'console-home', 'stats-backlog', 'console-game'].map(
      async (name) => [name, await backdrop(name)],
    ),
  ),
);
const [lib, home, col, yir] = await Promise.all(
  ['console-library', 'console-home', 'collection', 'year-in-review'].map(medium),
);
const wallStyle = `--img-lib:${lib};--img-home:${home};--img-col:${col};--img-yir:${yir}`;

const [features, guides, compare, release, downloadCount] = await Promise.all([
  articles('features', lang),
  articles('guides', lang),
  articles('compare', lang),
  latest(),
  totalDownloads(),
]);
const reads = [
  ...guides.slice(0, 5).map((g) => ({ href: articleUrl('guides', slugOf(g), lang), title: g.data.navLabel, summary: g.data.summary, label: text.article.labels.guides, cta: text.article.readMore })),
  ...compare.map((c) => ({ href: articleUrl('compare', slugOf(c), lang), title: c.data.navLabel, summary: c.data.summary, label: text.article.labels.compare, cta: text.article.readMore })),
];

// A line icon per feature page, for the home grid.
const featureIcons: Record<string, string> = {
  'game-library':
    '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  'stores':
    '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  'emulation':
    '<path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/><path d="M17.3 5H6.7a4 4 0 0 0-4 3.6C2.6 9.4 2 14.5 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.4-1.4A2 2 0 0 1 9.8 16h4.4a2 2 0 0 1 1.4.6L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.5-.6-6.6-.7-7.3A4 4 0 0 0 17.3 5Z"/>',
  'wine-and-proton':
    '<path d="M8 22h8M12 15v7M7 10h10"/><path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5Z"/>',
  'console-mode':
    '<rect x="2" y="7" width="20" height="15" rx="2"/><path d="m17 2-5 5-5-5"/>',
  'play-time-tracking':
    '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  'saves-and-backups':
    '<path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7M7 3v4a1 1 0 0 0 1 1h7"/>',
  'performance':
    '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/>',
};

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Heronite',
  description: t.appDescription,
  url: new URL(to('/'), site.url).toString(),
  image: `${site.url}/og.png`,
  inLanguage: localeInfo[lang].htmlLang,
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Game launcher',
  operatingSystem: 'Windows 10, Windows 11, Linux',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  downloadUrl: site.releases,
  installUrl: new URL(to('/download/'), site.url).toString(),
  ...(release ? { softwareVersion: version(release), datePublished: release.date.slice(0, 10) } : {}),
  releaseNotes: `${site.url}/changelog/`,
  author: { '@type': 'Person', name: site.author },
  publisher: { '@id': `${site.url}/#org` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: t.featureList,
};
---

<Base title={t.title} description={t.description} jsonLd={[softwareApplication]}>
  <header class="hero">
    <div class="wall" id="wall" style={wallStyle} role="img" aria-label={t.wallLabel}>
  <div class="row r1"><div class="track"><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:949.8;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:1100.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:648.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:11.8;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-lib" style="--x:1100.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:1073.8;--y:442.5;--w:151;--h:202"></i><i class="cv s-home" style="--x:41.5;--y:325.5;--w:134;--h:207"></i><i class="cv s-lib" style="--x:799.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:949.8;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:1100.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:648.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:11.8;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-lib" style="--x:1100.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:1073.8;--y:442.5;--w:151;--h:202"></i><i class="cv s-home" style="--x:41.5;--y:325.5;--w:134;--h:207"></i><i class="cv s-lib" style="--x:799.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"