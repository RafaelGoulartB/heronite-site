---
import '../styles/home.css';
import '../styles/content.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ShotImg from '../components/ShotImg.astro';
import DownloadCards from '../components/DownloadCards.astro';
import Faq from '../components/Faq.astro';
import { medium } from '../lib/shots';
import { articles, articleUrl, slugOf } from '../lib/content';
import { latest, releases, totalDownloads, version } from '../lib/releases';
import { formatStars, stars } from '../lib/stars';
import { downloads, site, stores } from '../data/site';
import type { IconName } from '../data/icons';
import { fill, formatDate, localeInfo, localize, useText, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const text = useText(lang);
const t = text.home;
const to = (path: string) => localize(lang, path);

const [lib, home, col, yir] = await Promise.all(
  ['console-library', 'console-home', 'collection', 'year-in-review'].map(medium),
);
const wallStyle = `--img-lib:${lib};--img-home:${home};--img-col:${col};--img-yir:${yir}`;

// The cover wall: each cover is cropped out of a screenshot, as "screenshot x y w h" in its 1280px
// copy. Each row repeats three times so it can slide by a third and loop.
const wallRows = [
  ['lib 41.5 164.5 135 209', 'home 347.2 332.5 125.7 194.5', 'lib 347.2 171 125.7 194.5', 'yir 903.2 108.5 151 202', 'lib 949.8 390.5 125.7 194.5', 'home 1100.5 332.5 125.7 194.5', 'lib 648.5 171 125.7 194.5', 'col 11.8 55.5 78.3 119.5', 'lib 1100.5 390.5 125.7 194.5', 'yir 1073.8 442.5 151 202', 'home 41.5 325.5 134 207', 'lib 799.2 171 125.7 194.5'],
  ['lib 196.5 171 125.7 194.5', 'home 648.5 332.5 125.7 194.5', 'lib 347.2 390.5 125.7 194.5', 'col 194.5 55.5 78.3 119.5', 'home 196.5 332.5 125.7 194.5', 'yir 732.5 237.5 151 202', 'lib 949.8 171 125.7 194.5', 'home 799.2 332.5 125.7 194.5', 'lib 497.8 171 125.7 194.5', 'col 13.5 207.5 75 116', 'yir 1073.8 216.5 151 202', 'home 497.8 332.5 125.7 194.5'],
  ['lib 45.8 390.5 125.7 194.5', 'lib 196.5 390.5 125.7 194.5', 'lib 799.2 390.5 125.7 194.5', 'home 949.8 332.5 125.7 194.5', 'lib 1100.5 171 125.7 194.5', 'col 194.5 533.8 78.3 119.5', 'yir 903.2 333.5 151 202', 'lib 648.5 390.5 125.7 194.5', 'col 103.5 55.5 78.3 119.5', 'yir 732.5 462.5 151 202', 'lib 497.8 390.5 125.7 194.5'],
  ['yir 1073.8 442.5 151 202', 'lib 799.2 171 125.7 194.5', 'col 11.8 55.5 78.3 119.5', 'lib 41.5 164.5 135 209', 'yir 903.2 108.5 151 202', 'lib 1100.5 390.5 125.7 194.5', 'lib 949.8 390.5 125.7 194.5', 'home 41.5 325.5 134 207', 'lib 347.2 171 125.7 194.5', 'lib 648.5 171 125.7 194.5', 'home 347.2 332.5 125.7 194.5', 'home 1100.5 332.5 125.7 194.5'],
].map((row) =>
  row.map((cover) => {
    const [img, x, y, w, h] = cover.split(' ');
    return { img, style: `--x:${x};--y:${y};--w:${w};--h:${h}` };
  }),
);

const [guides, compare, release, starCount, downloadCount, allReleases] = await Promise.all([
  articles('guides', lang),
  articles('compare', lang),
  latest(),
  stars(),
  totalDownloads(),
  releases(),
]);
// How busy the project is: the number of releases and the date of the latest.
const activity = release && fill(t.maker.activity, {
  count: allReleases.length,
  date: formatDate(lang, new Date(release.date)),
});
const numberFormat = localeInfo[lang].htmlLang;
const starText = formatStars(starCount, numberFormat);
// The next round number of stars, for the progress bar under the maker's note.
const goal = Math.max(100, Math.ceil((starCount + 1) / 50) * 50);
const size = (name: string) => {
  const asset = release?.assets.find((a) => a.name === name);
  return asset ? `${Math.round(asset.size / 1e6)} MB` : '';
};
const ver = release ? version(release) : '';
const downloadText = new Intl.NumberFormat(numberFormat, { notation: 'compact', maximumFractionDigits: 1 }).format(downloadCount);

// A store logo for the guides that are about one store.
const guideIcons: Record<string, IconName> = {
  'epic-games-on-linux': 'epic',
  'gog-on-linux': 'gog',
  'amazon-games-on-linux': 'amazon',
  'battle-net-on-linux': 'battlenet',
  'ea-app-ubisoft-rockstar-on-linux': 'ea',
  'steam-deck': 'steam',
};

// The features without a section of their own. Each shows one panel of the app, cut on its own
// edges and sized to read; `crop` is the panel in the 1280px frame.
const extras = [
  { key: 'stores', slug: 'stores', shot: 'command-palette', crop: '--x:432;--y:58;--w:416;--h:166', fade: true },
  { key: 'linux', slug: 'wine-and-proton', shot: 'collection', crop: '--x:304;--y:472;--w:194;--h:120', fade: false },
  { key: 'emulation', slug: 'emulation', shot: 'emulators', crop: '--x:92;--y:125;--w:545;--h:177', fade: false },
  { key: 'wine-and-proton', slug: 'wine-and-proton', shot: 'game-settings', crop: '--x:898;--y:152;--w:362;--h:160', fade: false },
  { key: 'saves-and-backups', slug: 'saves-and-backups', shot: 'backups', crop: '--x:421;--y:305;--w:591;--h:227', fade: false },
] as const;

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Heronite',
  description: t.appDescription,
  url: new URL(to('/'), site.url).toString(),
  image: `${site.url}/og.png`,
  inLanguage: localeInfo[lang].htmlLang,
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Game launcher',
  operatingSystem: 'Windows 10, Windows 11, Linux',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  downloadUrl: site.releases,
  installUrl: new URL(to('/download/'), site.url).toString(),
  ...(release ? { softwareVersion: version(release), datePublished: release.date.slice(0, 10) } : {}),
  releaseNotes: `${site.url}/changelog/`,
  author: { '@type': 'Person', name: site.author },
  publisher: { '@id': `${site.url}/#org` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: t.featureList,
};
---

<Base title={t.title} description={t.description} jsonLd={[softwareApplication]}>
  <header class="hero" id="top">
    <div class="hero-top">
      <div class="wall" id="wall" style={wallStyle} role="img" aria-label={t.wallLabel}>
        {wallRows.map((row, i) => (
          <div class={`row r${i + 1}`}><div class="track">
            {[0, 1, 2].map(() => row.map((c) => <i class={`cv s-${c.img}`} style={c.style}></i>))}
          </div></div>
        ))}
      </div>
      <div class="wrap hero-copy">
        <h1 class="h1" set:html={t.headlineHtml} />
        <p class="lead">{t.lead}</p>
        <div class="actions">
          <a class="btn btn-primary dl-btn" id="dl-main" href={to('/download/')}>
            <i class="glyph g-a" aria-hidden="true">A</i>
            <span class="dl-label">{t.downloadFree}</span>
          </a>
          <a class="btn btn-ghost star-btn" href={site.repo}>
            <i class="glyph g-y" aria-hidden="true">Y</i>
            <span>{t.star}</span>
          </a>
          <button class="btn btn-ghost send-btn" type="button" hidden data-copied={t.copied}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            <span>{t.sendToPc}</span>
          </button>
        </div>
        <p class="hero-meta">
          {ver && <span>v{ver}</span>}
          <span id="dl-format" data-linux={`AppImage · ${size('Heronite-x86_64.AppImage')}`} data-windows={`${t.installer} · ${size('Heronite-Setup-x86_64.exe')}`}>{t.platforms}</span>
          {downloadCount >= 1000 && <span>{fill(t.downloads, { count: downloadText })}</span>}
          <a href={to('/download/')}>{t.otherDownloads}</a>
        </p>
      </div>
      <button class="motion" id="motion" type="button" aria-controls="wall" aria-pressed="false" data-pause={t.pauseMotion} data-play={t.playMotion}>{t.pauseMotion}</button>
    </div>

    <div class="wrap">
      <figure class="anno">
        <div class="pins">
          <div class="frame">
            <ShotImg name="collection" eager sizes="(max-width: 760px) 280vw, min(1312px, calc(100vw - 48px))" alt={t.collection.alt} />
          </div>
          <div class="callout to-right" style="--x:5.95%;--y:5.3%;--len:18px" aria-hidden="true"><span class="dot">1</span><span class="tip">{t.collection.callouts[0]}</span></div>
          <div class="callout to-right" style="--x:5.75%;--y:46.9%;--len:22px" aria-hidden="true"><span class="dot">2</span><span class="tip">{t.collection.callouts[1]}</span></div>
          <div class="callout to-down" style="--x:34.1%;--y:81.6%;--len:22px;--tx:-3.3cqw" aria-hidden="true"><span class="dot">3</span><span class="tip">{t.collection.callouts[2]}</span></div>
          <div class="callout to-right" style="--x:45.5%;--y:60.8%;--len:10px" aria-hidden="true"><span class="dot">4</span><span class="tip">{t.collection.callouts[3]}</span></div>
          <div class="callout to-down-end" style="--x:91.2%;--y:4.9%;--len:24px" aria-hidden="true"><span class="dot">5</span><span class="tip">{t.collection.callouts[4]}</span></div>
        </div>
        <figcaption class="sr-only">{t.collection.caption}</figcaption>
        <ol class="legend" aria-label={t.collection.legendLabel}>
          {t.collection.callouts.map((c) => <li>{c}</li>)}
        </ol>
      </figure>

      <div class="sources" role="region" aria-labelledby="h-src">
        <h2 id="h-src">{t.sources}</h2>
        <ul class="src-logos">
          {stores.map((s) => <li title={s.name}><Icon name={s.icon} /><span class="sr">{s.name}</span></li>)}
        </ul>
        <a class="src-more" href={to('/features/stores/')}>{t.sourcesMore} &rarr;</a>
      </div>
    </div>
  </header>

  <main id="main">

  <!-- ============ THE REST OF THE SETUP ============ -->
  <section class="sec" id="features" aria-labelledby="h-extras">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2" id="h-extras">{t.extras.headline}</h2>
        <p class="lead">{t.extras.lead}</p>
      </div>
      <ul class="extras">
        {extras.map((e) => {
          const tile = t.extras.tiles[e.key];
          return (
            <li class={`extra x-${e.key}`}>
              <div class="stage"><div class={e.fade ? 'crop panel fade' : 'crop panel'} style={e.crop}><ShotImg name={e.shot} alt={tile.alt} /></div></div>
              <div class="extra-text">
                <h3><a href={articleUrl('features', e.slug, lang)}>{tile.title}</a></h3>
                <p>{tile.text}</p>
              </div>
            </li>
          );
        })}
      </ul>
      <a class="more-link" href={to('/features/')}>{t.extras.link} &rarr;</a>
    </div>
  </section>

  <!-- ============ HISTORY ============ -->
  <section class="sec sec-hist" id="history" aria-labelledby="h-hist">
    <div class="wrap hist">
      <figure class="tile t-yir"><div class="crop" style="--x:851;--y:211;--w:262;--h:422"><ShotImg name="year-in-review-wrap" alt={t.history.tiles.yir.alt} /></div><figcaption>{t.history.tiles.yir.caption}</figcaption></figure>
      <div class="hist-head">
        <h2 class="h2" id="h-hist">{t.history.headline}</h2>
        <p class="lead">{t.history.lead}</p>
        <a class="more-link" href={to('/features/play-time-tracking/')}>{t.history.link} &rarr;</a>
      </div>
      <figure class="tile t-num"><div class="crop" style="--x:20;--y:128;--w:360;--h:150;--ax:0.1"><ShotImg name="statistics" alt={t.history.tiles.num.alt} /></div><figcaption>{t.history.tiles.num.caption}</figcaption></figure>
      <figure class="tile t-goal"><div class="crop" style="--x:990;--y:140;--w:262;--h:122"><ShotImg name="stats-backlog" alt={t.history.tiles.goal.alt} /></div><figcaption>{t.history.tiles.goal.caption}</figcaption></figure>
      <figure class="tile t-chart"><div class="crop" style="--x:30;--y:352;--w:800;--h:236;--mx:30;--my:352;--mw:430;--mh:236;--ax:0"><ShotImg name="statistics" alt={t.history.tiles.chart.alt} /></div><figcaption>{t.history.tiles.chart.caption}</figcaption></figure>
    </div>
  </section>

  <!-- ============ CONSOLE MODE ============ -->
  <section class="sec sec-console" id="console" aria-labelledby="h-console">
    <div class="wrap">
      <figure class="handheld">
        <div class="hh-body">
          <span class="hh-side hh-l" aria-hidden="true"><i class="hh-stick"></i><i class="hh-dpad"></i><i class="hh-pad"></i></span>
          <div class="hh-screen"><ShotImg name="console-home" sizes="(max-width: 1100px) calc(100vw - 32px), 1000px" alt={t.console.homeAlt} /></div>
          <span class="hh-side hh-r" aria-hidden="true"><i class="hh-abxy"><b></b><b></b><b></b><b></b></i><i class="hh-stick"></i><i class="hh-pad"></i></span>
        </div>
      </figure>
      <div class="cons-head">
        <div>
          <h2 class="h2" id="h-console">{t.console.headline}</h2>
          <p class="lead">{t.console.lead}</p>
          <a class="more-link" href={to('/features/console-mode/')}>{t.console.link} &rarr;</a>
        </div>
        <ul class="cons-facts">
          <li><span class="cf-key" aria-hidden="true"><i class="glyph g-a">A</i><i class="glyph g-b">B</i></span><span>{t.console.pad}</span></li>
          <li><b>{t.console.count}</b><span>{t.console.themes}</span></li>
          <li><span class="cf-key" aria-hidden="true"><Icon name="steam" /></span><span set:html={t.console.deckHtml} /></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ PERFORMANCE ============ -->
  <section class="sec sec-perf" id="light" aria-labelledby="h-light">
    <div class="wrap perf">
      <h2 id="h-light"><span class="perf-big">215<small>ms</small></span><span class="perf-line">{t.light.headline}</span></h2>
      <div class="perf-side">
        <p class="lead">{t.light.lead}</p>
        <div class="perf-actions">
          <a class="btn btn-primary dl-btn" id="dl-perf" href={to('/download/')}>
            <i class="glyph g-a" aria-hidden="true">A</i>
            <span class="dl-label">{t.downloadFree}</span>
          </a>
          <a class="more-link" href={to('/features/performance/')}>{t.light.link} &rarr;</a>
        </div>
      </div>
      <ul class="perf-list">
        <li><b>190<small>MB</small></b><span>{t.light.memory}</span></li>
        <li><b>0.1<small>%</small></b><span>{t.light.cpu}</span></li>
        <li><b>64<small>MB</small></b><span>{t.light.install}</span></li>
        <li><b>0</b><span>{t.light.browsers}</span></li>
      </ul>
    </div>
  </section>

  <!-- ============ SWITCHING ============ -->
  <section class="sec sec-switch" id="switch" aria-labelledby="h-switch">
    <div class="wrap switch">
      <div class="switch-copy">
        <h2 class="h2" id="h-switch">{t.switch.headline}</h2>
        <p class="lead">{t.switch.lead}</p>
      </div>
      <ul class="switch-list">
        {compare.map((c) => {
          const slug = slugOf(c);
          return (
            <li>
              <a href={articleUrl('compare', slug, lang)}>
                <span class="sw-name">{c.data.navLabel}</span>
                <span class="sw-line">{t.switch.lines[slug]}</span>
                <span class="sw-go" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ============ DOWNLOAD ============ -->
  <section class="sec sec-dl" id="download" aria-labelledby="h-dl">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2" id="h-dl">{t.download.headline}</h2>
        <p class="lead">{t.download.lead}</p>
        <button class="btn btn-primary send-btn" type="button" hidden data-copied={t.copied}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          <span>{t.sendToPc}</span>
        </button>
      </div>
      <DownloadCards />
      <div class="maker">
        <img src="/icon.png" alt="" width="52" height="52" loading="lazy" />
        <div class="maker-text">
          <p set:html={fill(t.maker.textHtml, { author: site.author })} />
          <div class="goal" aria-hidden="true"><span style={`width:${Math.min(100, (starCount / goal) * 100).toFixed(1)}%`}></span></div>
          <p class="goal-text"><span>{fill(t.maker.goal, { count: starText, goal })}</span>{activity && <span>{activity}</span>}</p>
        </div>
        <a class="btn btn-star" href={site.repo}>
          <Icon name="star" />
          <span>{t.star}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ GUIDES ============ -->
  <section class="sec sec-guides" aria-labelledby="h-guides">
    <div class="wrap guides">
      <div class="guides-head">
        <h2 class="h2" id="h-guides">{t.guides.headline}</h2>
        <p class="lead">{t.guides.lead}</p>
        <a class="more-link" href={to('/guides/')}>{t.guides.link} &rarr;</a>
      </div>
      <ul class="guide-list">
        {guides.map((g) => {
          const slug = slugOf(g);
          const icon = guideIcons[slug];
          return (
            <li>
              <a href={articleUrl('guides', slug, lang)}>
                <span class="g-ico" aria-hidden="true">{icon ? <Icon name={icon} /> : <Icon name="linux" />}</span>
                <span class="g-title">{g.data.navLabel}</span>
                <span class="g-go" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ============ QUESTIONS ============ -->
  <section class="sec sec-faq" aria-label={t.faqTitle}>
    <div class="wrap faq-grid">
      <Faq items={t.faq} title={t.faqTitle} open={t.faqOpen} />
      <p class="faq-stuck" set:html={fill(t.stuckHtml, { discussions: site.discussions, email: site.email })} />
    </div>
  </section>

  <!-- ============ CLOSING ============ -->
  <section class="closing" id="close" aria-labelledby="h-close" style={wallStyle}>
    <div class="closing-strip" aria-hidden="true">
      {wallRows[1].concat(wallRows[0]).map((c) => <i class={`cv s-${c.img}`} style={c.style}></i>)}
    </div>
    <div class="wrap closing-copy">
      <h2 class="h2" id="h-close">{t.closing.headline}</h2>
      <div class="actions">
        <a class="btn btn-primary dl-btn" id="dl-close" href={to('/download/')}>
          <i class="glyph g-a" aria-hidden="true">A</i>
          <span class="dl-label">{t.downloadFree}</span>
        </a>
        <a class="btn btn-ghost star-btn" href={site.repo}>
          <i class="glyph g-y" aria-hidden="true">Y</i>
          <span>{t.star}</span>
        </a>
        <button class="btn btn-ghost send-btn" type="button" hidden data-copied={t.copied}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          <span>{t.sendToPc}</span>
        </button>
        <a class="back-top" href="#top"><i class="glyph g-b" aria-hidden="true">B</i>{t.backToTop}</a>
      </div>
    </div>
  </section>
  </main>

  <div class="phone-bar" id="phone-bar" hidden>
    <a class="btn btn-primary" href={site.repo}><Icon name="star" /><span>{t.star}</span></a>
    <button class="btn btn-ghost send-btn" type="button" hidden data-copied={t.copied} aria-label={t.sendToPc}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      <span>{t.sendShort}</span>
    </button>
  </div>

  <aside class="after-dl" id="after-dl" hidden aria-live="polite">
    <button class="after-close" type="button" aria-label={t.afterDownload.close}>&times;</button>
    <p class="after-title">{t.afterDownload.title}</p>
    <p>{t.afterDownload.text}</p>
    <div class="actions">
      <a class="btn btn-star" href={site.repo}><Icon name="star" /><span>{t.star}</span></a>
      <a class="link" href={to('/docs/installation/')}>{t.afterDownload.install} &rarr;</a>
    </div>
  </aside>

  <script is:inline define:vars={{ installer: downloads.windowsInstaller, appImage: downloads.appImage, labelWindows: t.downloadWindows, labelLinux: t.downloadLinux }}>
    var root = document.documentElement;
    root.classList.add('js');
    var ua = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent || '';
    var phone = /android|iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.userAgentData && navigator.userAgentData.mobile);
    var fmt = document.getElementById('dl-format');
    var set = function (href, label, format) {
      document.querySelectorAll('.dl-btn').forEach(function (a) {
        a.href = href;
        a.querySelector('.dl-label').textContent = label;
      });
      fmt.textContent = format;
    };
    if (phone) {
      // A phone can't install a desktop launcher: offer to send the page to a PC instead.
      root.classList.add('phone');
      document.querySelectorAll('.send-btn').forEach(function (send) {
        send.hidden = false;
        send.addEventListener('click', function () {
          var url = location.href.split('#')[0];
          if (navigator.share) navigator.share({ title: document.title, url: url }).catch(function () {});
          else if (navigator.clipboard) navigator.clipboard.writeText(url).then(function () { send.querySelector('span').textContent = send.dataset.copied; });
        });
      });
      // Between the hero and the closing band, keep the two phone actions in reach.
      var bar = document.getElementById('phone-bar'), seen = {};
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { seen[e.target.id] = e.isIntersecting; });
        bar.hidden = !!(seen.top || seen.close);
      });
      io.observe(document.getElementById('top'));
      io.observe(document.getElementById('close'));
    } else if (/win/i.test(ua)) set(installer, labelWindows, fmt.dataset.windows);
    else if (/linux|x11/i.test(ua)) set(appImage, labelLinux, fmt.dataset.linux);
    // Once a download starts, suggest a star while it finishes.
    var after = document.getElementById('after-dl');
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="/releases/"]');
      if (a && /\/download\//.test(a.href)) after.hidden = false;
    });
    after.querySelector('.after-close').addEventListener('click', function () { after.hidden = true; });
    var b = document.getElementById('motion'), w = document.getElementById('wall');
    b.addEventListener('click', function () {
      var p = w.classList.toggle('paused');
      b.setAttribute('aria-pressed', p);
      b.textContent = p ? b.dataset.play : b.dataset.pause;
    });
  </script>
