:533.8;--w:78.3;--h:119.5"></i><i class="cv s-yir" style="--x:903.2;--y:333.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:648.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:103.5;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-yir" style="--x:732.5;--y:462.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:497.8;--y:390.5;--w:125.7;--h:194.5"></i></div></div>
  <div class="row r4"><div class="track"><i class="cv s-yir" style="--x:1073.8;--y:442.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:799.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:11.8;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:1100.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:949.8;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:41.5;--y:325.5;--w:134;--h:207"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:648.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:1100.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:1073.8;--y:442.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:799.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:11.8;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:1100.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:949.8;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:41.5;--y:325.5;--w:134;--h:207"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:648.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:1100.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:1073.8;--y:442.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:799.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:11.8;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:1100.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:949.8;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:41.5;--y:325.5;--w:134;--h:207"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:648.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:1100.5;--y:332.5;--w:125.7;--h:194.5"></i></div></div>
    </div>

    <div class="hero-copy" id="top">
      <div class="hero-panel">
        {release && <a class="news" href="/changelog/"><b>{fill(t.news, { version: version(release) })}</b><span>{t.newsLink} &rarr;</span></a>}
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="h1" set:html={t.headlineHtml} />
        <p class="lead">{t.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" id="dl-main" href={to('/download/')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg>
            <span id="dl-label">{t.downloadFree}</span></a>
          <a class="link" href={to('/features/')}>{t.allFeatures} &rarr;</a>
        </div>
        <ul class="facts">
          {t.facts.map((fact) => <li>{fact}</li>)}
          {downloadCount >= 1000 && <li>{fill(t.downloads, { count: downloadCount.toLocaleString(localeInfo[lang].date) })}</li>}
        </ul>
      </div>
    </div>
    <button class="motion" id="motion" type="button" aria-controls="wall" aria-pressed="false" data-pause={t.pauseMotion} data-play={t.playMotion}>{t.pauseMotion}</button>
  </header>

  <main id="main">

  <!-- ============ SOURCES + ANNOTATED COLLECTION ============ -->
  <section class="scene sc-col" style={`--art:url(${bg["statistics"]});--pos:50% 14%;--size:200%;--bright:.95`} id="collection" aria-labelledby="h-col">
    <div class="wrap">
      <div class="sources glass" role="region" aria-labelledby="h-src">
        <h2 id="h-src" class="eyebrow">{t.sources}</h2>
        <ul class="src-logos">
          {stores.map((s) => <li title={s.name}><Icon name={s.icon} /><span class="sr">{s.name}</span></li>)}
          <li class="more"><a href={to('/features/stores/')}>{t.sourcesMore}</a></li>
        </ul>
      </div>

      <div class="head">
        <div>
          <p class="eyebrow">{t.collection.eyebrow}</p>
          <h2 class="h2" id="h-col" set:html={t.collection.headlineHtml} />
        </div>
        <div class="lead"><p>{t.collection.lead}</p><a class="more-link" href={to('/features/game-library/')}>{t.collection.link} &rarr;</a></div>
      </div>

      <figure class="anno">
        <div class="pins">
          <div class="frame">
            <ShotImg name="collection" sizes="(max-width: 760px) calc(100vw - 32px), min(1312px, calc(100vw - 48px))" alt={t.collection.alt} />
          </div>
          <div class="callout to-right" style="--x:5.95%;--y:5.3%;--len:18px" aria-hidden="true"><span class="dot">1</span><span class="tip">{t.collection.callouts[0]}</span></div>
          <div class="callout to-right" style="--x:5.75%;--y:46.9%;--len:22px" aria-hidden="true"><span class="dot">2</span><span class="tip">{t.collection.callouts[1]}</span></div>
          <div class="callout to-down" style="--x:34.1%;--y:81.6%;--len:22px;--tx:-3.3cqw" aria-hidden="true"><span class="dot">3</span><span class="tip">{t.collection.callouts[2]}</span></div>
          <div class="callout to-right" style="--x:45.5%;--y:60.8%;--len:10px" aria-hidden="true"><span class="dot">4</span><span class="tip">{t.collection.callouts[3]}</span></div>
          <div class="callout to-down-end" style="--x:91.2%;--y:4.9%;--len:24px" aria-hidden="true"><span class="dot">5</span><span class="tip">{t.collection.callouts[4]}</span></div>
        </div>
        <figcaption class="sr-only">{t.collection.caption}</figcaption>
        <ol class="legend glass" aria-label={t.collection.legendLabel}>
          {t.collection.callouts.map((c) => <li>{c}</li>)}
        </ol>
      </figure>
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="scene sc-feat" style={`--art:url(${bg["console-library"]});--pos:50% 40%;--bright:.55;--blur:80px`} id="features" aria-labelledby="h-feat">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">{t.features.eyebrow}</p>
          <h2 class="h2" id="h-feat" set:html={t.features.headlineHtml} />
        </div>
        <div class="lead"><p>{t.features.lead}</p><a class="more-link" href={to('/features/')}>{t.features.link} &rarr;</a></div>
      </div>
      <ul class="feats">
        {features.map((f) => {
          const slug = slugOf(f);
          const card = t.features.cards[slug];
          return (
            <li class="feat glass">
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={featureIcons[slug]} /></span>
              <h3><a href={articleUrl('features', slug, lang)}>{f.data.navLabel}</a></h3>
              <p>{card.text}</p>
              <ul class="chips">{card.chips.map((c) => <li>{c}</li>)}</ul>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ============ HISTORY ============ -->
  <section class="scene sc-hist" style={`--art:url(${bg["year-in-review"]});--pos:85% 50%;--size:200%;--bright:.9`} id="history" aria-labelledby="h-hist">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">{t.history.eyebrow}</p>
          <h2 class="h2" id="h-hist" set:html={t.history.headlineHtml} />
        </div>
        <div class="lead"><p>{t.history.lead}</p><a class="more-link" href={to('/features/play-time-tracking/')}>{t.history.link} &rarr;</a></div>
      </div>
      <div class="hist">
  <figure class="tile glass t-num"><div class="crop" style="--x:20;--y:128;--w:360;--h:150;--ax:0.1"><ShotImg name="statistics" alt={t.history.tiles.num.alt} /></div><figcaption><span class="lbl">{t.history.tiles.num.label}</span>{t.history.tiles.num.caption}</figcaption></figure>

  <figure class="tile glass t-goal"><div class="crop" style="--x:990;--y:140;--w:262;--h:122"><ShotImg name="stats-backlog" alt={t.history.tiles.goal.alt} /></div><figcaption><span class="lbl">{t.history.tiles.goal.label}</span>{t.history.tiles.goal.caption}</figcaption></figure>

  <figure class="tile glass t-chart"><div class="crop" style="--x:30;--y:352;--w:800;--h:236;--mx:30;--my:352;--mw:430;--mh:236;--ax:0"><ShotImg name="statistics" alt={t.history.tiles.chart.alt} /></div><figcaption><span class="lbl">{t.history.tiles.chart.label}</span>{t.history.tiles.chart.caption}</figcaption></figure>

  <figure class="tile glass t-yir"><div class="crop" style="--x:851;--y:211;--w:262;--h:422"><ShotImg name="year-in-review-wrap" alt={t.history.tiles.yir.alt} /></div><figcaption><span class="lbl">{t.history.tiles.yir.label}</span>{t.history.tiles.yir.caption}</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- ============ CONSOLE MODE ============ -->
  <section class="scene sc-console" style={`--art:url(${bg["console-home"]});--pos:60% 60%;--bright:.8`} id="console" aria-labelledby="h-console">
    <div class="wrap">
      <div class="cons">
        <div class="cons-panel glass">
          <p class="eyebrow">{t.console.eyebrow}</p>
          <h2 class="h2" id="h-console" set:html={t.console.headlineHtml} />
          <p class="lead">{t.console.lead}</p>
          <a class="more-link" href={to('/features/console-mode/')}>{t.console.link} &rarr;</a>
          <ul class="bignums">
            <li><b>8</b>{t.console.layouts}</li>
            <li><b>7</b>{t.console.themes}</li>
            <li class="wide" set:html={t.console.shareHtml} />
          </ul>
        </div>
        <div class="cons-shots">
          <figure class="shot">
            <ShotImg name="console-home" sizes="(max-width: 1100px) calc(100vw - 32px), 860px" alt={t.console.homeAlt} />
          </figure>
          <figure class="shot small">
            <div class="crop" style="--x:36;--y:56;--w:520;--h:262;--ax:0"><ShotImg name="console-game" alt={t.console.gameAlt} /></div>
            <figcaption>{t.console.gameCaption}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LIGHT ============ -->
  <section class="scene sc-light" style={`--art:url(${bg["stats-backlog"]});--pos:50% 10%;--size:200%;--bright:.8`} id="light" aria-labelledby="h-light">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">{t.light.eyebrow}</p>
          <h2 class="h2" id="h-light" set:html={t.light.headlineHtml} />
        </div>
        <div class="lead"><p>{t.light.lead}</p><a class="more-link" href={to('/features/performance/')}>{t.light.link} &rarr;</a></div>
      </div>
      <ul class="meter glass">
        <li><p class="num"><i>~</i>215<small>ms</small></p><p class="cap">{t.light.launch}</p></li>
        <li><p class="num"><i>~</i>190<small>MB</small></p><p class="cap">{t.light.memory}</p></li>
        <li><p class="num"><i>~</i>0.1<small>%</small></p><p class="cap">{t.light.cpu}</p></li>
        <li><p class="num">64<small>MB</small></p><p class="cap">{t.light.install}</p></li>
      </ul>
    </div>
  </section>

  <!-- ============ DOWNLOAD ============ -->
  <section class="scene sc-dl" id="download" aria-labelledby="h-dl" style={`--art:url(${bg['console-game']});--pos:60% 30%;--bright:.85`}>
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">{t.download.eyebrow}</p>
          <h2 class="h2" id="h-dl" set:html={t.download.headlineHtml} />
        </div>
        <p class="lead">{t.download.lead}</p>
      </div>
      <DownloadCards />
    </div>
  </section>

  <!-- ============ GUIDES AND QUESTIONS ============ -->
  <section class="scene sc-faq" aria-labelledby="h-guides">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">{t.guides.eyebrow}</p>
          <h2 class="h2" id="h-guides" set:html={t.guides.headlineHtml} />
        </div>
        <div class="lead"><p>{t.guides.lead}</p><a class="more-link" href={to('/guides/')}>{t.guides.link} &rarr;</a></div>
      </div>
      <ul class="cards">
        {reads.map((r) => <ArticleCard {...r} />)}
      </ul>
      <div style="margin-top:72px">
        <Faq items={t.faq} title={t.faqTitle} />
      </div>
    </div>
  </section>
  </main>

  <script is:inline define:vars={{ installer: downloads.windowsInstaller, appImage: downloads.appImage, labelWindows: t.downloadWindows, labelLinux: t.downloadLinux }}>
    document.documentElement.classList.add('js');
    var ua = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent || '';
    var a = document.getElementById('dl-main'), l = document.getElementById('dl-label');
    if (/win/i.test(ua)) { a.href = installer; l.textContent = labelWindows; }
    else if (/linux|x11/i.test(ua) && !/android/i.test(navigator.userAgent)) { a.href = appImage; l.textContent = labelLinux; }
    var b = document.getElementById('motion'), w = document.getElementById('wall');
    b.addEventListener('click', function () {
      var p = w.classList.toggle('paused');
      b.setAttribute('aria-pressed', p);
      b.textContent = p ? b.dataset.play : b.dataset.pause;
    });
  </script>
</Base>
