---
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '@fontsource/rubik/700.css';
import '@fontsource/cabin/400.css';
import '@fontsource/cabin/500.css';
import '@fontsource/cabin/600.css';
import rubikBold from '@fontsource/rubik/files/rubik-latin-700-normal.woff2?url';
import cabinRegular from '@fontsource/cabin/files/cabin-latin-400-normal.woff2?url';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Social card, a path under public/ (1200x630). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  /** Extra schema.org objects for this page. */
  jsonLd?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og.png',
  imageAlt = 'Heronite, a game launcher for Linux and Windows, showing a library of game covers',
  type = 'website',
  published,
  modified,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// The site and its publisher, on every page, so search engines tie the pages together.
const graph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: 'Heronite',
    url: `${site.url}/`,
    inLanguage: 'en',
    publisher: { '@id': `${site.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#org`,
    name: 'Heronite',
    url: `${site.url}/`,
    logo: `${site.url}/icon.png`,
    email: site.email,
    sameAs: [site.repo],
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={rubikBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cabinRegular} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0d11" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.author} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Heronite" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
