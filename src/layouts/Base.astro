---
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '@fontsource/rubik/700.css';
import '@fontsource/cabin/400.css';
import '@fontsource/cabin/500.css';
import '@fontsource/cabin/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import rubikBold from '@fontsource/rubik/files/rubik-latin-700-normal.woff2?url';
import cabinRegular from '@fontsource/cabin/files/cabin-latin-400-normal.woff2?url';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { analyticsToken, site } from '../data/site';
import { alternatesFor, basePath, localeInfo, localeOf, locales, useText, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Social card, a path under public/ (1200x630). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  /** Extra schema.org objects for this page. */
  jsonLd?: object[];
  noindex?: boolean;
  /** The language versions of this page; every language by default. */
  alternates?: Partial<Record<Locale, string>>;
}

const lang = localeOf(Astro.url.pathname);
const text = useText(lang);
const {
  title,
  description,
  image = '/og.png',
  imageAlt = text.meta.ogImageAlt,
  type = 'website',
  published,
  modified,
  jsonLd = [],
  noindex = false,
  alternates = alternatesFor(basePath(Astro.url.pathname)),
} = Astro.props;
const info = localeInfo[lang];
const otherLangs = (Object.keys(alternates) as Locale[]).filter((l) => l !== lang);

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// The site and its publisher, on every page, so search engines tie the pages together.
const graph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: 'Heronite',
    url: `${site.url}/`,
    inLanguage: locales.map((locale) => localeInfo[locale].htmlLang),
    publisher: { '@id': `${site.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#org`,
    name: 'Heronite',
    url: `${site.url}/`,
    logo: `${site.url}/icon.png`,
    email: site.email,
    sameAs: [site.repo],
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang={info.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && Object.keys(alternates).length > 1 && (
      <>
        {(Object.entries(alternates) as [Locale, string][]).map(([l, href]) => (
          <link rel="alternate" hreflang={localeInfo[l].htmlLang} href={new URL(href, Astro.site)} />
        ))}
        {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />}
      </>
    )}
    <link rel="preload" href={rubikBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cabinRegular} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="128x128" href="/icon-small.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0d11" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.author} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Heronite" />
    <meta property="og:locale" content={info.og} />
    {otherLangs.map((l) => <meta property="og:locale:alternate" content={localeInfo[l].og} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
    {import.meta.env.PROD && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">{text.nav.skip}</a>
    <Header alternates={alternates} />
    <slot />
    <Footer />
  </body>
</html>
