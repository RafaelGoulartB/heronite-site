---
import '../../styles/content.css';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { docs, docUrl } from '../../lib/content';
import { site } from '../../data/site';

const groups = await docs();
const intro = {
  Start: 'Install Heronite, set it up and fix what goes wrong.',
  Guides: 'Each part of the app, explained.',
  Reference: 'Shortcuts, options, files and formats.',
  Contribute: 'Help make Heronite better.',
};
---

<Base
  title="Heronite Documentation: Install, Set Up and Use the Launcher"
  description="The Heronite documentation: installing on Linux and Windows, stores, emulation, Wine and Proton, console mode, backups, keyboard shortcuts and troubleshooting."
  image="/og/docs.jpg"
>
  <main id="main">
    <header class="index-hero">
      <div class="wrap">
        <Breadcrumbs items={[{ label: 'Docs', href: '/docs/' }]} />
        <p class="eyebrow">Documentation</p>
        <h1 class="h1">Heronite <em>docs</em></h1>
        <p class="lead">Everything about installing, setting up and using Heronite on Linux and Windows. Can't find something? Ask in <a class="link" href={site.discussions}>Discussions</a>.</p>
      </div>
    </header>
    <div class="wrap index-body">
      {groups.map((g) => (
        <section class="index-group" aria-labelledby={`g-${g.section}`}>
          <h2 id={`g-${g.section}`}>{g.section} <span class="fine">· {intro[g.section]}</span></h2>
          <ul class="cards">
            {g.pages.map((p) => (
              <ArticleCard href={docUrl(p.id)} title={p.data.navLabel ?? p.data.title} summary={p.data.description} cta="Read" />
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</Base>
