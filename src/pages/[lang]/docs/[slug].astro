---
import DocPage from '../../../views/DocPage.astro';
import { getCollection } from 'astro:content';
import { langOf, slugOf } from '../../../lib/content';
import { otherLocales } from '../../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('docs', (e) => (otherLocales as string[]).includes(langOf(e)));
  return entries.map((entry) => ({ params: { lang: langOf(entry), slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<DocPage entry={entry} />
