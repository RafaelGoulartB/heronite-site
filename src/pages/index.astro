i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:1100.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:949.8;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:41.5;--y:325.5;--w:134;--h:207"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:648.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:1100.5;--y:332.5;--w:125.7;--h:194.5"></i></div></div>
    </div>

    <div class="hero-copy" id="top">
      <div class="hero-panel">
        <p class="eyebrow">Game launcher for Linux and Windows</p>
        <h1 class="h1">Every game<br> you own.<br> <em>One launcher.</em></h1>
        <p class="lead">Steam, Epic, GOG, Amazon, Battle.net, emulators and more, in one fast native app. Free and open source.</p>
        <div class="actions">
          <a class="btn btn-primary" id="dl-main" href="/download/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg>
            <span id="dl-label">Download free</span></a>
          <a class="link" href="/features/">See all features &rarr;</a>
        </div>
        <ul class="facts">
          <li>Free and open source</li>
          <li>No account</li>
          <li>No ads</li>
        </ul>
      </div>
    </div>
    <button class="motion" id="motion" type="button" aria-controls="wall" aria-pressed="false">Pause motion</button>
  </header>

  <main id="main">

  <!-- ============ SOURCES + ANNOTATED COLLECTION ============ -->
  <section class="scene sc-col" style={`--art:url(${bg["statistics"]});--pos:50% 14%;--size:200%;--bright:.95`} id="collection" aria-labelledby="h-col">
    <div class="wrap">
      <div class="sources glass" role="region" aria-labelledby="h-src">
        <h2 id="h-src" class="eyebrow">Plays games from</h2>
        <ul class="src-logos">
          {stores.map((s) => <li title={s.name}><Icon name={s.icon} /><span class="sr">{s.name}</span></li>)}
          <li class="more"><a href="/features/stores/">+ emulators &amp; your own games</a></li>
        </ul>
      </div>

      <div class="head">
        <div>
          <p class="eyebrow">Collection</p>
          <h2 class="h2" id="h-col">One shelf for <em>everything.</em></h2>
        </div>
        <div class="lead"><p>Your stores, emulators and loose games, sorted the way you like.</p><a class="more-link" href="/features/game-library/">How the library works &rarr;</a></div>
      </div>

      <figure class="anno">
        <div class="pins">
          <div class="frame">
            <ShotImg name="collection" sizes="(max-width: 760px) calc(100vw - 32px), min(1312px, calc(100vw - 48px))" alt="Heronite's Collection: game covers grouped into Playing and On Going, with play time under each, and ELDEN RING open with its cover, Play button, score, Linux rating and a timeline of play sessions." />
          </div>
          <div class="callout to-right" style="--x:5.95%;--y:5.3%;--len:18px" aria-hidden="true"><span class="dot">1</span><span class="tip">Group by status</span></div>
          <div class="callout to-right" style="--x:5.75%;--y:46.9%;--len:22px" aria-hidden="true"><span class="dot">2</span><span class="tip">Play time per game</span></div>
          <div class="callout to-down" style="--x:34.1%;--y:81.6%;--len:22px;--tx:-3.3cqw" aria-hidden="true"><span class="dot">3</span><span class="tip">Linux rating and anti-cheat</span></div>
          <div class="callout to-right" style="--x:45.5%;--y:60.8%;--len:10px" aria-hidden="true"><span class="dot">4</span><span class="tip">Your timeline</span></div>
          <div class="callout to-down-end" style="--x:91.2%;--y:4.9%;--len:24px" aria-hidden="true"><span class="dot">5</span><span class="tip">List or grid of covers</span></div>
        </div>
        <figcaption class="sr-only">The Collection screen in Heronite, with five highlighted parts.</figcaption>
        <ol class="legend glass" aria-label="What the numbers point at">
          <li>Group by status</li>
          <li>Play time per game</li>
          <li>Linux rating and anti-cheat</li>
          <li>Your timeline</li>
          <li>List or grid of covers</li>
        </ol>
      </figure>
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="scene sc-feat" style={`--art:url(${bg["console-library"]});--pos:50% 40%;--bright:.55;--blur:80px`} id="features" aria-labelledby="h-feat">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">Features</p>
          <h2 class="h2" id="h-feat">Everything it does, <em>in one app.</em></h2>
        </div>
        <div class="lead"><p>Each feature has its own page, with screenshots and the details.</p><a class="more-link" href="/features/">All features &rarr;</a></div>
      </div>
      <ul class="feats">
        {features.map((f) => {
          const extra = featureCards[f.id];
          return (
            <li class="feat glass">
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={extra.icon} /></span>
              <h3><a href={articleUrl('features', f.id)}>{f.data.navLabel}</a></h3>
              <p>{extra.text}</p>
              <ul class="chips">{extra.chips.map((c) => <li>{c}</li>)}</ul>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ============ HISTORY ============ -->
  <section class="scene sc-hist" style={`--art:url(${bg["year-in-review"]});--pos:85% 50%;--size:200%;--bright:.9`} id="history" aria-labelledby="h-hist">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">History</p>
          <h2 class="h2" id="h-hist">Every session, <em>remembered.</em></h2>
        </div>
        <div class="lead"><p>Each time you play is recorded, with stats, a backlog goal and a year in review.</p><a class="more-link" href="/features/play-time-tracking/">Play time tracking &rarr;</a></div>
      </div>
      <div class="hist">
  <figure class="tile glass t-num"><div class="crop" style="--x:20;--y:128;--w:360;--h:150;--ax:0.1"><ShotImg name="statistics" alt="Statistics header: 32 hours 56 minutes played in October 2026, 19 of 20 days, 16-day streak, 61 sessions" /></div><figcaption><span class="lbl">Time played</span>Every session counted, by week, month or year.</figcaption></figure>

  <figure class="tile glass t-goal"><div class="crop" style="--x:990;--y:140;--w:262;--h:122"><ShotImg name="stats-backlog" alt="Goal for 2026 ring: 9 of 12 games beaten, with pace notes" /></div><figcaption><span class="lbl">Backlog</span>Set a yearly goal and watch the ring fill.</figcaption></figure>

  <figure class="tile glass t-chart"><div class="crop" style="--x:30;--y:352;--w:800;--h:236;--mx:30;--my:352;--mw:430;--mh:236;--ax:0"><ShotImg name="statistics" alt="Day by day bar chart, each bar split by game" /></div><figcaption><span class="lbl">Statistics</span>See which games filled each day.</figcaption></figure>

  <figure class="tile glass t-yir"><div class="crop" style="--x:851;--y:211;--w:262;--h:422"><ShotImg name="year-in-review-wrap" alt="Year in review card: I played for 711h 31m, 217 days, 681 sessions, 57 games, top three games" /></div><figcaption><span class="lbl">Year in review</span>Your year in games, told as stories.</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- ============ CONSOLE MODE ============ -->
  <section class="scene sc-console" style={`--art:url(${bg["console-home"]});--pos:60% 60%;--bright:.8`} id="console" aria-labelledby="h-console">
    <div class="wrap">
      <div class="cons">
        <div class="cons-panel glass">
          <p class="eyebrow">Console mode</p>
          <h2 class="h2" id="h-console">From desk <em>to couch.</em></h2>
          <p class="lead">A controller-first layout for the TV, with the same library behind it.</p>
          <a class="more-link" href="/features/console-mode/">Explore console mode &rarr;</a>
          <ul class="bignums">
            <li><b>8</b>layouts</li>
            <li><b>7</b>built-in themes</li>
            <li class="wide"><b>Export &amp; import</b>your own themes</li>
          </ul>
        </div>
        <div class="cons-shots">
          <figure class="shot">
            <ShotImg name="console-home" sizes="(max-width: 1100px) calc(100vw - 32px), 860px" alt="Console mode home: SP Football Life 2026 in focus above a Continue playing shelf of covers, controller hints along the bottom" />
          </figure>
          <figure class="shot small">
            <div class="crop" style="--x:36;--y:56;--w:520;--h:262;--ax:0"><ShotImg name="console-game" alt="Console game page for Elden Ring with a large Play button" /></div>
            <figcaption>Game pages built for a controller.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LIGHT ============ -->
  <section class="scene sc-light" style={`--art:url(${bg["stats-backlog"]});--pos:50% 10%;--size:200%;--bright:.8`} id="light" aria-labelledby="h-light">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">Performance</p>
          <h2 class="h2" id="h-light">Light on <em>your PC.</em></h2>
        </div>
        <div class="lead"><p>A native Rust app drawn on the GPU. No bundled browser.</p><a class="more-link" href="/features/performance/">Why it is fast &rarr;</a></div>
      </div>
      <ul class="meter glass">
        <li><p class="num"><i>~</i>215<small>ms</small></p><p class="cap">from launch to your library</p></li>
        <li><p class="num"><i>~</i>190<small>MB</small></p><p class="cap">memory while idle</p></li>
        <li><p class="num"><i>~</i>0.1<small>%</small></p><p class="cap">CPU while idle</p></li>
        <li><p class="num">64<small>MB</small></p><p class="cap">to install</p></li>
      </ul>
    </div>
  </section>

  <!-- ============ DOWNLOAD ============ -->
  <section class="scene sc-dl" id="download" aria-labelledby="h-dl" style={`--art:url(${bg['console-game']});--pos:60% 30%;--bright:.85`}>
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">Download</p>
          <h2 class="h2" id="h-dl">Get Heronite. <em>It's free.</em></h2>
        </div>
        <p class="lead">Open source under GPL-3.0. No account, no ads.</p>
      </div>
      <DownloadCards />
    </div>
  </section>

  <!-- ============ GUIDES AND QUESTIONS ============ -->
  <section class="scene sc-faq" aria-labelledby="h-guides">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">Guides</p>
          <h2 class="h2" id="h-guides">Play anything, <em>anywhere.</em></h2>
        </div>
        <div class="lead"><p>Step by step guides for Linux, the Steam Deck and coming from other launchers.</p><a class="more-link" href="/guides/">All guides &rarr;</a></div>
      </div>
      <ul class="cards">
        {reads.map((r) => <ArticleCard {...r} />)}
      </ul>
      <div style="margin-top:72px">
        <Faq items={faq} title="Common questions" />
      </div>
    </div>
  </section>
  </main>

  <script is:inline define:vars={{ installer: downloads.windowsInstaller, appImage: downloads.appImage }}>
    document.documentElement.classList.add('js');
    var ua = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent || '';
    var a = document.getElementById('dl-main'), l = document.getElementById('dl-label');
    if (/win/i.test(ua)) { a.href = installer; l.textContent = 'Download for Windows'; }
    else if (/linux|x11/i.test(ua) && !/android/i.test(navigator.userAgent)) { a.href = appImage; l.textContent = 'Download for Linux'; }
    var b = document.getElementById('motion'), w = document.getElementById('wall');
    b.addEventListener('click', function () {
      var p = w.classList.toggle('paused');
      b.setAttribute('aria-pressed', p);
      b.textContent = p ? 'Play motion' : 'Pause motion';
    });
  </script>
</Base>
