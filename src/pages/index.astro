---
import '../styles/home.css';
import '../styles/content.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ShotImg from '../components/ShotImg.astro';
import DownloadCards from '../components/DownloadCards.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Faq from '../components/Faq.astro';
import { backdrop, medium } from '../lib/shots';
import { articles, articleUrl } from '../lib/content';
import { downloads, site, stores } from '../data/site';

const bg = Object.fromEntries(
  await Promise.all(
    ['statistics', 'console-library', 'year-in-review', 'console-home', 'stats-backlog', 'console-game'].map(
      async (name) => [name, await backdrop(name)],
    ),
  ),
);
const [lib, home, col, yir] = await Promise.all(
  ['console-library', 'console-home', 'collection', 'year-in-review'].map(medium),
);
const wallStyle = `--img-lib:url(${lib});--img-home:url(${home});--img-col:url(${col});--img-yir:url(${yir})`;

const [features, guides, compare] = await Promise.all([articles('features'), articles('guides'), articles('compare')]);
const reads = [
  ...guides.slice(0, 4).map((g) => ({ href: articleUrl('guides', g.id), title: g.data.navLabel, summary: g.data.summary, label: 'Guide' })),
  ...compare.slice(0, 2).map((c) => ({ href: articleUrl('compare', c.id), title: c.data.navLabel, summary: c.data.summary, label: 'Compare' })),
];

const faq = [
  {
    q: 'Is Heronite free?',
    a: 'Yes. Heronite is free and open source under the GPL-3.0 license. There are no accounts, no ads and no telemetry, and the [source code is on GitHub](https://github.com/RafaelGoulartB/Heronite).',
  },
  {
    q: 'Which games and stores does it support?',
    a: 'Steam, Epic Games, GOG and Amazon Games on Linux and Windows; Battle.net, EA app, Ubisoft Connect and Rockstar Games on Linux; emulated games from RetroArch, PCSX2, Dolphin, RPCS3 and many other emulators; and any game you add yourself. See [stores and launchers](/features/stores/).',
  },
  {
    q: 'Can I play Epic Games and GOG games on Linux with Heronite?',
    a: 'Yes. Log in on the Stores page and Heronite installs, updates and launches your Epic, GOG and Amazon games through Wine or Proton, using the same open source tools as Heroic. Read the [Epic Games on Linux guide](/guides/epic-games-on-linux/).',
  },
  {
    q: 'Does it work on the Steam Deck?',
    a: 'Yes. Heronite runs as an AppImage in SteamOS desktop mode, and its console mode is built for controllers. Add it to Steam with the `--console` option to use it from Gaming Mode. See [Heronite on Steam Deck](/guides/steam-deck/).',
  },
  {
    q: 'How is Heronite different from Playnite, Heroic or Lutris?',
    a: 'Heronite runs on both Linux and Windows, covers every major store plus emulators in one library, records every session for statistics, and is a native Rust app that idles at about 190 MB of memory. Read the comparisons with [Playnite](/compare/playnite/), [Heroic](/compare/heroic/) and [Lutris](/compare/lutris/).',
  },
  {
    q: 'Will I lose my Heroic or Lutris setup?',
    a: 'No. Heronite only reads the files of other launchers. It can import your games from Heroic, Lutris, Bottles and Faugus and keep them in sync, and those launchers keep working as before.',
  },
];

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Heronite',
  description:
    'A free, open source game launcher for Linux and Windows that brings Steam, Epic Games, GOG, Amazon Games, Battle.net, EA app, Ubisoft Connect, Rockstar Games and emulators into one library.',
  url: `${site.url}/`,
  image: `${site.url}/og.png`,
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Game launcher',
  operatingSystem: 'Windows 10, Windows 11, Linux',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  downloadUrl: site.releases,
  installUrl: `${site.url}/download/`,
  author: { '@type': 'Person', name: site.author },
  publisher: { '@id': `${site.url}/#org` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'One library for Steam, Epic Games, GOG, Amazon Games, Battle.net, EA app, Ubisoft Connect and Rockstar Games',
    'Emulator frontend with ROM folder scanning',
    'Wine and Proton manager for Linux',
    'Play time tracking, statistics and year in review',
    'Controller-first console mode with themes',
    'Save backups with Ludusavi',
  ],
};
---

<Base
  title="Heronite: Free Open Source Game Launcher for Linux & Windows"
  description="A free, open source game launcher for Linux and Windows. Steam, Epic, GOG, Amazon, Battle.net and emulators in one fast native app, with play stats and a couch mode."
  jsonLd={[softwareApplication]}
>
