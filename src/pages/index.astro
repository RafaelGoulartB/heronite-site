  <script is:inline define:vars={{ installer: downloads.windowsInstaller, appImage: downloads.appImage }}>
    document.documentElement.classList.add('js');
    var ua = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent || '';
    var a = document.getElementById('dl-main'), l = document.getElementById('dl-label');
    if (/win/i.test(ua)) { a.href = installer; l.textContent = 'Download for Windows'; }
    else if (/linux|x11/i.test(ua) && !/android/i.test(navigator.userAgent)) { a.href = appImage; l.textContent = 'Download for Linux'; }
    var b = document.getElementById('motion'), w = document.getElementById('wall');
    b.addEventListener('click', function () {
      var p = w.classList.toggle('paused');
      b.setAttribute('aria-pressed', p);
      b.textContent = p ? 'Play motion' : 'Pause motion';
    });
  </script>
</Base>
