    <div class="hero-copy" id="top">
      <div class="hero-panel">
        <p class="eyebrow">Game launcher for Linux and Windows</p>
        <h1 class="h1">Every game<br> you own.<br> <em>One launcher.</em></h1>
        <p class="lead">Steam, Epic, GOG, Amazon, Battle.net, emulators and more, in one fast native app. Free and open source.</p>
        <div class="actions">
          <a class="btn btn-primary" id="dl-main" href="/download/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg>
            <span id="dl-label">Download free</span></a>
          <a class="link" href="/features/">See all features &rarr;</a>
        </div>
        <ul class="facts">
          <li>Free and open source</li>
          <li>No account</li>
          <li>No ads</li>
        </ul>
      </div>
    </div>
    <button class="motion" id="motion" type="button" aria-controls="wall" aria-pressed="false">Pause motion</button>
  </header>

  <main id="main">

  <!-- ============ SOURCES + ANNOTATED COLLECTION ============ -->
  <section class="scene sc-col" style={`--art:url(${bg["statistics"]});--pos:50% 14%;--size:200%;--bright:.95`} id="collection" aria-labelledby="h-col">
    <div class="wrap">
      <div class="sources glass" role="region" aria-labelledby="h-src">
        <h2 id="h-src" class="eyebrow">Plays games from</h2>
        <ul class="src-logos">
          {stores.map((s) => <li title={s.name}><Icon name={s.icon} /><span class="sr">{s.name}</span></li>)}
          <li class="more"><a href="/features/stores/">+ emulators &amp; your own games</a></li>
        </ul>
      </div>

      <div class="head">
        <div>
          <p class="eyebrow">Collection</p>
          <h2 class="h2" id="h-col">One shelf for <em>everything.</em></h2>
        </div>
        <div class="lead"><p>Your stores, emulators and loose games, sorted the way you like.</p><a class="more-link" href="/features/game-library/">How the library works &rarr;</a></div>
      </div>

      <figure class="anno">
        <div class="pins">
          <div class="frame">
            <ShotImg name="collection" alt="Heronite's Collection: game covers grouped into Playing and On Going, with play time under each, and ELDEN RING open with its cover, Play button, score, Linux rating and a timeline of play sessions." />
          </div>
          <div class="callout to-right" style="--x:5.95%;--y:5.3%;--len:18px" aria-hidden="true"><span class="dot">1</span><span class="tip">Group by status</span></div>
