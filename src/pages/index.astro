---
import Base from '../layouts/Base.astro';
---

<Base
  title="Heronite: every game you own, in one fast native launcher"
  description="Heronite is a free, open source game launcher for Linux and Windows. Steam, Epic Games, GOG, Amazon Games, emulators and more in one library, with play time stats and a console mode."
>
  <a class="skip" href="#main">Skip to content</a>

  <header class="hero">
    <div class="nav">
      <div class="wrap">
        <div class="bar glass">
          <a class="brand" href="#top" aria-label="Heronite, back to top">
            <img src="/icon.png" alt="" width="26" height="26">
            <span>HERONITE</span>
          </a>
          <nav class="tabs" aria-label="Sections">
            <a href="#collection">Library</a>
            <a href="#history">History</a>
            <a href="#console">Console mode</a>
            <a href="#light">Performance</a>
          </nav>
          <a class="gh" href="https://github.com/RafaelGoulartB/Heronite">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
            <span>GitHub</span>
          </a>
          <a class="btn btn-primary" href="#download">Download</a>
        </div>
      </div>
    </div>

    <div class="wall" id="wall" role="img" aria-label="A wall of game covers from a Heronite library, cropped from the app's own screenshots">
