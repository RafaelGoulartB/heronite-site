---
import '../styles/home.css';
import '../styles/content.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ShotImg from '../components/ShotImg.astro';
import DownloadCards from '../components/DownloadCards.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Faq from '../components/Faq.astro';
import { backdrop, medium } from '../lib/shots';
import { articles, articleUrl } from '../lib/content';
import { downloads, site, stores } from '../data/site';

const bg = Object.fromEntries(
  await Promise.all(
    ['statistics', 'console-library', 'year-in-review', 'console-home', 'stats-backlog', 'console-game'].map(
      async (name) => [name, await backdrop(name)],
    ),
  ),
);
const [lib, home, col, yir] = await Promise.all(
  ['console-library', 'console-home', 'collection', 'year-in-review'].map(medium),
);
const wallStyle = `--img-lib:${lib};--img-home:${home};--img-col:${col};--img-yir:${yir}`;

const [features, guides, compare] = await Promise.all([articles('features'), articles('guides'), articles('compare')]);
// The short version of each feature page for the home grid: a line icon, one line and a few keywords.
const featureCards: Record<string, { icon: string; text: string; chips: string[] }> = {
  'game-library': {
    icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
    text: 'Every game in one Collection, sorted and grouped your way.',
    chips: ['Saved views', 'Bulk edits', 'Ctrl+K palette', 'Journal'],
  },
  stores: {
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
    text: 'Log in once and every store library joins the same list.',
    chips: ['Steam', 'Epic', 'GOG', 'Amazon', 'Battle.net'],
  },
  emulation: {
    icon: '<path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/><path d="M17.3 5H6.7a4 4 0 0 0-4 3.6C2.6 9.4 2 14.5 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.4-1.4A2 2 0 0 1 9.8 16h4.4a2 2 0 0 1 1.4.6L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.5-.6-6.6-.7-7.3A4 4 0 0 0 17.3 5Z"/>',
    text: 'Finds your emulators and turns ROM folders into games.',
    chips: ['RetroArch', 'PCSX2', 'Dolphin', 'RPCS3', '+13 more'],
  },
  'wine-and-proton': {
    icon: '<path d="M8 22h8M12 15v7M7 10h10"/><path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5Z"/>',
    text: 'Windows games on Linux, tuned per game.',
    chips: ['GE-Proton', 'DXVK', 'gamescope', 'Sandbox'],
  },
  'console-mode': {
    icon: '<rect x="2" y="7" width="20" height="15" rx="2"/><path d="m17 2-5 5-5-5"/>',
    text: 'A controller-first layout for the couch and the TV.',
    chips: ['8 layouts', '7 themes', 'Steam Deck'],
  },
  'play-time-tracking': {
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
    text: 'Every session recorded, with stats and a year in review.',
    chips: ['Statistics', 'Backlog goal', 'Year in review'],
  },
  'saves-and-backups': {
    icon: '<path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7M7 3v4a1 1 0 0 0 1 1h7"/>',
    text: 'Game saves backed up after each session, the library on a schedule.',
    chips: ['Ludusavi', 'Scheduled backups', 'Storage map'],
  },
  performance: {
    icon: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/>',
    text: 'A native Rust app drawn on the GPU, with no bundled browser.',
    chips: ['~215 ms start', '~190 MB idle', 'No Electron'],
  },
};

const reads = [
  ...guides.slice(0, 5).map((g) => ({ href: articleUrl('guides', g.id), title: g.data.navLabel, summary: g.data.summary, label: 'Guide' })),
  ...compare.map((c) => ({ href: articleUrl('compare', c.id), title: c.data.navLabel, summary: c.data.summary, label: 'Compare' })),
];

const faq = [
  {
    q: 'Is Heronite free?',
    a: 'Yes. Heronite is free and open source under the GPL-3.0 license. There are no accounts, no ads and no telemetry, and the [source code is on GitHub](https://github.com/RafaelGoulartB/Heronite).',
  },
  {
    q: 'Which games and stores does it support?',
    a: 'Steam, Epic Games, GOG and Amazon Games on Linux and Windows; Battle.net, EA app, Ubisoft Connect and Rockstar Games on Linux; emulated games from RetroArch, PCSX2, Dolphin, RPCS3 and many other emulators; and any game you add yourself. See [stores and launchers](/features/stores/).',
  },
  {
    q: 'Can I play Epic Games and GOG games on Linux with Heronite?',
    a: 'Yes. Log in on the Stores page and Heronite installs, updates and launches your Epic, GOG and Amazon games through Wine or Proton, using the same open source tools as Heroic. Read the [Epic Games on Linux guide](/guides/epic-games-on-linux/).',
  },
  {
    q: 'Does it work on the Steam Deck?',
    a: 'Yes. Heronite runs as an AppImage in SteamOS desktop mode, and its console mode is built for controllers. Add it to Steam with the `--console` option to use it from Gaming Mode. See [Heronite on Steam Deck](/guides/steam-deck/).',
  },
  {
    q: 'How is Heronite different from Playnite, Heroic or Lutris?',
    a: 'Heronite runs on both Linux and Windows, covers every major store plus emulators in one library, records every session for statistics, and is a native Rust app that idles at about 190 MB of memory. Read the comparisons with [Playnite](/compare/playnite/), [Heroic](/compare/heroic/) and [Lutris](/compare/lutris/).',
  },
  {
    q: 'Will I lose my Heroic or Lutris setup?',
    a: 'No. Heronite only reads the files of other launchers. It can import your games from Heroic, Lutris, Bottles and Faugus and keep them in sync, and those launchers keep working as before.',
  },
];

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Heronite',
  description:
    'A free, open source game launcher for Linux and Windows that brings Steam, Epic Games, GOG, Amazon Games, Battle.net, EA app, Ubisoft Connect, Rockstar Games and emulators into one library.',
  url: `${site.url}/`,
  image: `${site.url}/og.png`,
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Game launcher',
  operatingSystem: 'Windows 10, Windows 11, Linux',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  downloadUrl: site.releases,
  installUrl: `${site.url}/download/`,
  author: { '@type': 'Person', name: site.author },
  publisher: { '@id': `${site.url}/#org` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'One library for Steam, Epic Games, GOG, Amazon Games, Battle.net, EA app, Ubisoft Connect and Rockstar Games',
    'Emulator frontend with ROM folder scanning',
    'Wine and Proton manager for Linux',
    'Play time tracking, statistics and year in review',
    'Controller-first console mode with themes',
    'Save backups with Ludusavi',
  ],
};
---

<Base
  title="Heronite: Free Open Source Game Launcher for Linux & Windows"
  description="A free, open source game launcher for Linux and Windows. Steam, Epic, GOG, Amazon, Battle.net and emulators in one fast native app, with play stats and a couch mode."
  jsonLd={[softwareApplication]}
>
  <header class="hero">
    <div class="wall" id="wall" style={wallStyle} role="img" aria-label="A wall of game covers from a Heronite library, cropped from the app's own screenshots">
  <div class="row r1"><div class="track"><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:949.8;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:1100.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:648.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:11.8;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-lib" style="--x:1100.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:1073.8;--y:442.5;--w:151;--h:202"></i><i class="cv s-home" style="--x:41.5;--y:325.5;--w:134;--h:207"></i><i class="cv s-lib" style="--x:799.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"></i><i class="cv s-lib" style="--x:949.8;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-home" style="--x:1100.5;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:648.5;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-col" style="--x:11.8;--y:55.5;--w:78.3;--h:119.5"></i><i class="cv s-lib" style="--x:1100.5;--y:390.5;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:1073.8;--y:442.5;--w:151;--h:202"></i><i class="cv s-home" style="--x:41.5;--y:325.5;--w:134;--h:207"></i><i class="cv s-lib" style="--x:799.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:41.5;--y:164.5;--w:135;--h:209"></i><i class="cv s-home" style="--x:347.2;--y:332.5;--w:125.7;--h:194.5"></i><i class="cv s-lib" style="--x:347.2;--y:171;--w:125.7;--h:194.5"></i><i class="cv s-yir" style="--x:903.2;--y:108.5;--w:151;--h:202"