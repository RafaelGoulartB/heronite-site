---
import '../styles/content.css';
import Base from '../layouts/Base.astro';
import { locales, localeInfo, localize, useText } from '../i18n';

// GitHub Pages serves this one file for every missing URL, so it links to each language.
const t = useText('en').notFound;
---

<Base title={t.title} description={t.description} noindex alternates={{ en: '/' }}>
  <main id="main">
    <header class="index-hero" style="min-height:70vh;display:flex;align-items:center">
      <div class="wrap">
        <h1 class="h1" set:html={t.headlineHtml} />
        <p class="lead">{t.lead}</p>
        <div class="actions" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:28px">
          <a class="btn btn-primary" href="/">Home</a>
          <a class="btn btn-ghost" href="/features/">Features</a>
          <a class="btn btn-ghost" href="/docs/">Docs</a>
          <a class="btn btn-ghost" href="/download/">Download</a>
        </div>
        <p class="meta">
          {locales.filter((l) => l !== 'en').map((l) => <a href={localize(l, '/')} lang={localeInfo[l].htmlLang}>{localeInfo[l].name}</a>)}
        </p>
      </div>
    </header>
  </main>
</Base>
