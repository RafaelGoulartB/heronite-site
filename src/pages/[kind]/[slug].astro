---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { articles, type Article, type ArticleKind } from '../../lib/content';

export async function getStaticPaths() {
  const kinds = ['features', 'guides', 'compare'] as const;
  const paths = await Promise.all(
    kinds.map(async (kind) =>
      (await articles(kind)).map((entry) => ({ params: { kind, slug: entry.id }, props: { entry, kind } })),
    ),
  );
  return paths.flat();
}

interface Props {
  entry: Article;
  kind: ArticleKind;
}

const { entry, kind } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} kind={kind} headings={headings}>
  <Content />
</ArticleLayout>
