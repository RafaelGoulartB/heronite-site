---
import ArticlePage from '../../views/ArticlePage.astro';
import { articles, slugOf } from '../../lib/content';

export async function getStaticPaths() {
  return (await articles('guides', 'en')).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<ArticlePage entry={entry} kind="guides" />
