---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  label?: string;
  image?: ImageMetadata;
  /** Which part of the screenshot to keep in the thumbnail, as CSS object-position. */
  focus?: string;
  cta?: string;
  level?: 'h2' | 'h3';
}

const { href, title, summary, label, image, focus, cta = 'Read more', level: H = 'h3' } = Astro.props;
---

<li>
  <article class="card glass">
    {image && (
      <div class="thumb" style={focus ? `--op:${focus}` : undefined}>
        <Image src={image} alt="" width={640} widths={[400, 640, 960]} sizes="(max-width: 760px) 100vw, 400px" quality={70} loading="lazy" />
      </div>
    )}
    <div class="body">
      {label && <span class="lbl">{label}</span>}
      <H><a href={href}>{title}</a></H>
      <p>{summary}</p>
      <span class="go" aria-hidden="true">{cta} &rarr;</span>
    </div>
  </article>
</li>
