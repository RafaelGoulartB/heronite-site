---
import Icon from './Icon.astro';
import { mainNav, site } from '../data/site';

const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
const isHome = path === '/';
---

<div class="nav">
  <div class="wrap">
    <div class="bar glass">
      <a class="brand" href="/" aria-label={isHome ? 'Heronite, back to top' : 'Heronite home'}>
        <img src="/icon.png" alt="" width="26" height="26">
        <span>HERONITE</span>
      </a>
      <nav class="tabs" aria-label="Main">
        {mainNav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
      </nav>
      <a class="gh" href={site.repo}>
        <Icon name="github" />
        <span>GitHub</span>
      </a>
      <a class="btn btn-primary" href="/download/">Download</a>
      <details class="menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <ul class="glass">
          <li><a href="/">Home</a></li>
          {mainNav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
          <li><a href="/download/" aria-current={current('/download/')}>Download</a></li>
          <li><a href={site.repo}>GitHub</a></li>
        </ul>
      </details>
    </div>
  </div>
</div>
