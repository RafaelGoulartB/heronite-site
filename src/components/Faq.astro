---
import { inlineMarkdown, stripMarkdown } from '../lib/text';
import { localeOf, useText } from '../i18n';

interface Props {
  items: { q: string; a: string }[];
  id?: string;
  title?: string;
  /** Which question starts open; the first by default. */
  open?: number;
}

const lang = localeOf(Astro.url.pathname);
const { items, id = 'faq', title = useText(lang).article.questions, open = 0 } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: stripMarkdown(item.a) },
  })),
};
---

{items.length > 0 && (
  <section class="faq" aria-labelledby={id}>
    <h2 id={id} class="faq-title">{title}</h2>
    <div class="faq-list">
      {items.map((item, i) => (
        <details class="glass" open={i === open}>
          <summary><h3>{item.q}</h3></summary>
          <p set:html={inlineMarkdown(item.a, lang)} />
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </section>
)}
