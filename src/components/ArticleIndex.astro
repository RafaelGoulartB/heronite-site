---
// The index page of features, guides or comparisons: a header and a card per page.
import '../styles/content.css';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleCard from './ArticleCard.astro';
import Cta from './Cta.astro';
import { articles, articleUrl, type ArticleKind } from '../lib/content';
import { accent } from '../lib/text';

interface Props {
  kind: ArticleKind;
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  lead: string;
  og?: string;
}

const { kind, title, description, eyebrow, headline, lead, og } = Astro.props;
const entries = await articles(kind);
const label = { features: 'Features', guides: 'Guides', compare: 'Compare' }[kind];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    hasPart: entries.map((e) => ({ '@type': 'WebPage', name: e.data.title, url: new URL(articleUrl(kind, e.id), Astro.site).toString() })),
  },
];
---

<Base title={title} description={description} image={og} jsonLd={jsonLd}>
  <main id="main">
    <header class="index-hero">
      <div class="wrap">
        <Breadcrumbs items={[{ label, href: `/${kind}/` }]} />
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="h1" set:html={accent(headline)} />
        <p class="lead">{lead}</p>
      </div>
    </header>
    <div class="wrap index-body">
      <ul class="cards">
        {entries.map((e) => (
          <ArticleCard href={articleUrl(kind, e.id)} title={e.data.navLabel} summary={e.data.summary} image={e.data.hero} label={e.data.eyebrow} level="h2" />
        ))}
      </ul>
    </div>
    <div class="wrap end-cta">
      <Cta />
    </div>
  </main>
</Base>
